# Regenerate the conformance vectors in t/vectors/ from INDEPENDENT oracles.
#
#   rakupp tools/gen-vectors.raku zlib   > t/vectors/zlib.vec
#   rakupp tools/gen-vectors.raku digest > t/vectors/digest.vec
#
# The point of each file is to be an oracle this project did not compute, so
# nothing here calls our own code: digests come from the system `openssl`,
# DEFLATE from real libz (Python's zlib module, which binds it) and the system
# gzip. That is also why it can run on Raku++ itself.
#
# These lived in the two distributions' tools/ until ORACLE-PLAN P0 brought
# them here, where the master copies of the .vec files are. The zlib half used
# Compress::Zlib under Rakudo then; Python's libz writes the same bytes (checked
# 2026-10-14: the regenerated file is identical to the committed one on macOS
# with zlib 1.2.12).
#
# What can move on another machine: the gzip header's OS byte (libz writes its
# own platform's), and the one stream from the system gzip if that gzip deflates
# differently. A vector that moves is still a correct vector; check the diff is
# only that before committing it. After any change, copy the file to the
# distribution too: t/regression/data-native-{zlib,digest}.raku hold the two
# copies byte-identical whenever both are present.

sub hex(Blob $b) { $b.list».fmt('%02x').join }

# ---- zlib -----------------------------------------------------------------

# One libz call, in Python: compress stdin with compress2 at a level, or through
# a deflate stream with the given window bits, flushed the way Compress::Zlib's
# Stream did (a sync flush, then finish), which is what the committed raw and
# gzip vectors are.
my $LIBZ = q:to/PY/;
import sys, zlib
mode, level = sys.argv[1], int(sys.argv[2])
data = sys.stdin.buffer.read()
if mode == 'zlib':
    out = zlib.compress(data, level)
else:
    c = zlib.compressobj(level, zlib.DEFLATED, -15 if mode == 'raw' else 31)
    out = c.compress(data) + c.flush(zlib.Z_SYNC_FLUSH) + c.flush(zlib.Z_FINISH)
sys.stdout.buffer.write(out)
PY

sub libz(Str $mode, Int $level, Blob $in) {
    my $p = run 'python3', '-I', '-c', $LIBZ, $mode, ~$level, :in, :out, :bin;
    $p.in.write($in); $p.in.close;
    my $out = $p.out.slurp(:close);
    die "python3 failed on $mode $level" unless $p.exitcode == 0;
    $out
}

sub zlib-vectors() {
    my @inputs =
        ''                                                   => 'empty',
        'a'                                                  => 'one byte',
        'hello world'                                        => 'short',
        ('ab' x 5000)                                        => 'a long run of one pair',
        ('The quick brown fox jumps over the lazy dog. ' x 200) => 'repeated prose',
        (^4096).map({ (($_ * 2654435761) % 251).chr }).join  => 'near-incompressible',
        ("\c[0]" x 100)                                      => 'a hundred NULs',
        'héllo wörld — ünïcode'                              => 'multi-byte UTF-8',
        ;

    say q:to/HEAD/.chomp;
    # zlib.vec — conformance vectors for the `zlib` family.
    #
    # ONE FILE, EVERY IMPLEMENTATION. The engine's src/Zlib.cpp and
    # Compress::Zlib::Native's C are separate implementations on purpose — see
    # NATIVE-MODULES-PLAN, "The architecture: independent C". This is what keeps
    # them agreeing, so it is read by both and weakened by neither.
    #
    # THIS COPY IS THE MASTER. It moved here from Compress-Zlib-Native/t/vectors/
    # when DATA-PLAN P4 landed and the engine became the primary implementation
    # (NATIVE-MODULES-PLAN's order of work, step 1, whose other half moved with
    # P3). The distribution keeps a copy so a published tarball stands alone;
    # t/regression/data-native-zlib.raku checks the two are byte-identical whenever
    # both are present.
    #
    # Generated by tools/gen-vectors.raku from real libz and the system gzip, never
    # from our own code. Compression is not a function, so what is pinned is the
    # direction that is: a stream a third party produced must inflate to exactly
    # the bytes they compressed.
    #
    #   I <zlib|gzip|raw> <compressed-hex> <plain-hex>   must inflate to plain
    #   X <zlib|gzip|raw> <compressed-hex>               must be REFUSED
    #   C <crc32-hex>  <input-hex>
    #   A <adler32-hex> <input-hex>
    #
    # `-` is the empty string in any of those fields.
    HEAD

    sub emit(Str $kind, *@f) { say ($kind, |@f.map({ $_ || '-' })).join(' ') }

    say '';
    for @inputs -> $p {
        my $plain = $p.key.encode('utf-8');
        emit 'I', 'zlib', hex(libz('zlib', $_, $plain)), hex($plain) for 1, 6, 9;
        emit 'I', $_, hex(libz($_, 6, $plain)), hex($plain) for <raw gzip>;
        emit 'C', sprintf('%08x', crc32-of($plain)), hex($plain);
        emit 'A', sprintf('%08x', adler32-of($plain)), hex($plain);
    }

    # The system gzip, which writes an FNAME field our header parser has to
    # skip — a shape libz's own stream never produces. The file's mtime goes
    # into the header, so it is pinned to the one the committed line carries.
    {
        my $dir = $*TMPDIR.add("gen-vectors-{$*PID}");
        $dir.mkdir;
        my $plain = ('gzip writes a name field into its header. ' x 40).encode('utf-8');
        my $f = $dir.add('sample.txt');
        $f.spurt($plain);
        run 'python3', '-I', '-c', 'import os, sys; os.utime(sys.argv[1], (1788598700, 1788598700))', $f.Str;
        run 'gzip', '-9', '-f', $f.Str;
        my $gz = $dir.add('sample.txt.gz').slurp(:bin);
        say '';
        say "# From the system gzip -9, so the FNAME field in the header is exercised.";
        emit 'I', 'gzip', hex($gz), hex($plain);
        .unlink for $dir.dir;
        $dir.rmdir;
    }

    # Streams that must be REFUSED. Every one is a specific way of being wrong,
    # so a decoder that accepts any of them has a real hole rather than a lenience.
    say '';
    say '# Malformed streams. Each must raise, and none may read out of bounds.';
    {
        my $good = libz('zlib', 6, 'hello world hello world'.encode);
        emit 'X', 'zlib', hex(Buf.new(0x00, 0x01, 0x02, 0x03, 0x04, 0x05));   # bad header
        emit 'X', 'zlib', hex($good.subbuf(0, $good.elems - 3));              # truncated
        emit 'X', 'zlib', hex(do { my $b = Buf.new($good); $b[$b.elems - 1] = $b[$b.elems - 1] +^ 0xff; $b });
        emit 'X', 'zlib', hex(do { my $b = Buf.new($good); $b[1] = $b[1] +^ 0x01; $b });  # header check
        emit 'X', 'gzip', hex(Buf.new(0x1f, 0x8b, 0x08, 0x00) ~ Buf.new(0 xx 20));
        emit 'X', 'gzip', hex(Buf.new(0x1f, 0x8c, 0x08, 0x00) ~ Buf.new(0 xx 20));  # bad magic
        emit 'X', 'raw',  hex(Buf.new(0xff, 0xff, 0xff, 0xff));               # invalid block type
        emit 'X', 'raw',  hex(Buf.new(0x01, 0x05, 0x00, 0x00, 0x00));         # stored LEN/NLEN mismatch
    }

    # CRC-32 and Adler-32 have published check values; they are here so the
    # file can be read by an implementation that has no oracle to hand.
    say '';
    say '# The published check strings.';
    emit 'C', 'cbf43926', hex('123456789'.encode);
    emit 'A', '091e01de', hex('123456789'.encode);
}

# The checksums are computed here, in Raku, from their definitions, and
# checked against the published values above: an error in either would move
# the check string.
sub crc32-of(Blob $b) {
    state @t = (^256).map: -> $i {
        my $c = $i;
        $c = $c +& 1 ?? 0xedb88320 +^ ($c +> 1) !! $c +> 1 for ^8;
        $c
    };
    my $c = 0xffffffff;
    $c = @t[($c +^ $_) +& 0xff] +^ ($c +> 8) for $b.list;
    $c +^ 0xffffffff
}
sub adler32-of(Blob $b) {
    my ($s1, $s2) = 1, 0;
    for $b.list { $s1 = ($s1 + $_) % 65521; $s2 = ($s2 + $s1) % 65521 }
    ($s2 +< 16) +| $s1
}

# ---- digest ---------------------------------------------------------------

sub digest-vectors() {
    my @ALGOS = <md5 sha1 sha224 sha256 sha384 sha512>;

    # An input is written <hex> or <hex>*<count>, so a million-byte message
    # costs one line. `-` is the empty input.
    sub spec(Str $s, Int $rep = 1) {
        return '-' if !$s && $rep == 1;
        my $hex = $s.encode('utf-8').list».fmt('%02x').join;
        $rep == 1 ?? $hex !! "$hex*$rep"
    }
    sub hexspec(Str $hex, Int $rep = 1) { $rep == 1 ?? $hex !! "$hex*$rep" }
    sub unspec(Str $spec) {
        return Buf.new if $spec eq '-';
        my ($h, $n) = $spec.split('*');
        my $once = Buf.new($h.comb(2).map({ :16($_) }));
        # latin-1 is a byte-for-byte codec both ways, so `x` on the decoded text
        # is a C-level string repeat — a million-byte input costs no Raku list.
        $n ?? ($once.decode('latin-1') x +$n).encode('latin-1') !! $once
    }
    sub openssl-dgst(Str $algo, Blob $in) {
        my $p = run('openssl', 'dgst', "-$algo", :in, :out);
        $p.in.write($in); $p.in.close;
        $p.out.slurp(:close).trim.split(/\s+/).tail
    }
    sub openssl-hmac(Str $algo, Blob $key, Blob $msg) {
        my $kh = hex($key);
        my $p = run('openssl', 'dgst', "-$algo", '-mac', 'HMAC', '-macopt', "hexkey:$kh", :in, :out);
        $p.in.write($msg); $p.in.close;
        $p.out.slurp(:close).trim.split(/\s+/).tail
    }

    say q:to/HEAD/.chomp;
    # digest.vec — conformance vectors for the `digest` family.
    #
    # ONE FILE, EVERY IMPLEMENTATION. The engine's src/Digest.cpp, Digest::Native's
    # C, and that distribution's ecosystem fallback are separate implementations on
    # purpose — see NATIVE-MODULES-PLAN, "The architecture: independent C". This
    # file is the thing that keeps them honest, so it is read by all of them and
    # weakened by none of them.
    #
    # THIS COPY IS THE MASTER. It moved here from Digest-Native/t/vectors/ when
    # DATA-PLAN P3 landed and the engine became the primary implementation
    # (NATIVE-MODULES-PLAN's order of work, step 1). The distribution keeps a copy
    # so a published tarball stands alone; t/regression/data-native-digest.raku
    # checks the two are byte-identical whenever both are present, so a vector
    # added on one side cannot quietly fail to reach the other.
    #
    # Generated by tools/gen-vectors.raku from the system openssl, never from our
    # own code. Every published constant it contains was also checked by eye
    # against RFC 1321, FIPS 180-4, RFC 2202 and RFC 4231.
    #
    #   H <algo> <input> <expected-hex>
    #   M <algo> <blocksize|-> <key> <message> <expected-hex>
    #
    # <input>, <key> and <message> are hex, optionally <hex>*<count> for a repeat,
    # and `-` for empty. A blocksize of `-` means the algorithm's own (RFC 2104),
    # which is what this family uses when the caller does not say.
    HEAD

    # ---- hashes: the published suites --------------------------------------
    my @inputs =
        spec(''),
        spec('a'),
        spec('abc'),
        spec('message digest'),
        spec('abcdefghijklmnopqrstuvwxyz'),
        spec('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'),
        spec('1234567890', 8),
        spec('abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq'),          # FIPS 448-bit
        spec('abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmno'
           ~ 'ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu'),                   # FIPS 896-bit
        spec('a', 1000000),                                                        # the long one
        hexspec('00'),                                                             # a NUL byte
        hexspec('00ff8041'),                                                       # bytes no text would carry
        hexspec('c3a9'),                                                           # é as UTF-8
        hexspec('61', 63), hexspec('61', 64), hexspec('61', 65),                    # block edges, 64
        hexspec('61', 127), hexspec('61', 128), hexspec('61', 129);                 # block edges, 128

    say '';
    for @ALGOS -> $a {
        for @inputs -> $in { say "H $a $in { openssl-dgst($a, unspec($in)) }" }
    }

    # ---- HMAC: RFC 2202 (md5, sha1) and RFC 4231 (sha2) ---------------------
    my @cases =
        (hexspec('0b', 20), spec('Hi There')),
        (spec('Jefe'),      spec('what do ya want for nothing?')),
        (hexspec('aa', 20), hexspec('dd', 50)),
        (hexspec('0102030405060708090a0b0c0d0e0f10111213141516171819'), hexspec('cd', 50)),
        (hexspec('0c', 20), spec('Test With Truncation')),
        (hexspec('aa', 131), spec('Test Using Larger Than Block-Size Key - Hash Key First')),
        (hexspec('aa', 131), spec('This is a test using a larger than block-size key and a '
                                ~ 'larger than block-size data. The key is hashed before being '
                                ~ 'used by the HMAC algorithm.'));

    say '';
    for @ALGOS -> $a {
        for @cases -> ($k, $m) { say "M $a - $k $m { openssl-hmac($a, unspec($k), unspec($m)) }" }
    }

    # An EXPLICIT block size is deliberately not in this file. openssl always
    # uses the algorithm's own, so it cannot be the oracle for
    # `hmac(…, &sha512, 64)` — and computing that value with our own code
    # would make the vector circular. Digest::HMAC is the honest oracle there,
    # since 64 is its default for every hash, and the distribution's
    # t/02-hmac.t asserts it against exactly that.
}

# Last, so every file-scope value above is set before a family runs.
given @*ARGS[0] // '' {
    when 'zlib'   { zlib-vectors() }
    when 'digest' { digest-vectors() }
    default { note 'usage: gen-vectors.raku zlib|digest'; exit 2 }
}
