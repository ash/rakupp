#!/usr/bin/env rakupp
# Generate src/unicode_props2_gen.cpp — enumerated Unicode properties as
# per-property range tables (lo, hi, value-index) plus a value-name table:
#   Age, Line_Break, Word_Break, Sentence_Break, Grapheme_Cluster_Break,
#   East_Asian_Width, Hangul_Syllable_Type, Joining_Type, Joining_Group,
#   Decomposition_Type, Numeric_Type, the four quick checks, the two Indic
#   categories, and Unicode_1_Name, Jamo_Short_Name, Bidi_Paired_Bracket,
#   and every value's aliases (PropertyValueAliases) —
# and src/unicode_mirror_gen.cpp, the Bidi_Mirroring_Glyph map.
#
# Two files because they sit on opposite sides of the SLIM seam (ucd_seam.h).
# Everything in the first is reached only by uniprop or <:Prop<Value>> naming
# the property, so it rides librakupp_ucd_props.a and --slim can cut it. The
# mirror map cannot be cut: the Lexer pairs a non-ASCII opening bracket with
# its closer through it, so EVAL in a slim binary needs it.
#
# Dogfooding: run by rakupp —  build/rakupp tools/gen_unicode_props2.raku
my $VER = '18.0.0';
sub p($f) { "tools/ucd/$f-$VER.txt" }

# Parse a "CODE(..CODE)? ; VALUE" file → list of [lo, hi, value-string].
# $field selects which ';'-separated field holds the value (default 1).
sub parse-ranges($path, :$field = 1) {
    my @rows;
    for $path.IO.lines -> $line {
        my $l = $line.split('#')[0].trim;
        next unless $l;
        my @f = $l.split(';').map(*.trim);
        next unless @f >= $field + 1;
        my ($lo, $hi) = @f[0].contains('..') ?? @f[0].split('..') !! (@f[0], @f[0]);
        @rows.push([:16($lo), :16($hi), @f[$field]]);
    }
    @rows.sort({ $^a[0] <=> $^b[0] });
}

my @out;
@out.push: "// GENERATED by tools/gen_unicode_props2.raku (run by rakupp) from Unicode $VER — do not edit.";
@out.push: '#include <cstdint>';
@out.push: '#include <cstddef>';
@out.push: '#include <cstring>';
@out.push: 'namespace rakupp { namespace ucd {';

# Emit a range table + value-name table for one enum property.
sub emit-enum($name, @rows) {
    my @vals;                    # ordered unique value names
    my %vidx;
    for @rows -> $r {
        unless %vidx{$r[2]}:exists { %vidx{$r[2]} = @vals.elems; @vals.push($r[2]); }
    }
    @out.push: "extern const char* const {$name}_VALUES[] = \{";
    @out.push: '  ' ~ @vals.map({ '"' ~ $_ ~ '"' }).join(',') ~ ',';
    @out.push: "\};";
    @out.push: "extern const size_t {$name}_VALUES_N = {@vals.elems};";
    @out.push: "extern const uint32_t {$name}_RANGES[] = \{";
    my $row = '  ';
    for @rows -> $r {
        $row ~= "0x{$r[0].base(16)},0x{$r[1].base(16)},{%vidx{$r[2]}},";
        if $row.chars > 110 { @out.push($row); $row = '  ' }
    }
    @out.push($row) if $row.trim;
    @out.push: "\};";
    @out.push: "extern const size_t {$name}_RANGES_N = {@rows.elems * 3};";
}

emit-enum('AGE',   parse-ranges(p('DerivedAge')));
emit-enum('LB',    parse-ranges(p('LineBreak')));
emit-enum('WB',    parse-ranges(p('WordBreakProperty')));
emit-enum('SB',    parse-ranges(p('SentenceBreakProperty')));
emit-enum('GCB',   parse-ranges(p('GraphemeBreakProperty')));
# East_Asian_Width is reported by its FULL value names ('Narrow', not 'Na') —
# uniprop is the only consumer, and Roast asks for the long form.
my %eaw-long = A => 'Ambiguous', F => 'Fullwidth', H => 'Halfwidth',
               N => 'Neutral',   Na => 'Narrow',   W => 'Wide';
emit-enum('EAW', parse-ranges(p('EastAsianWidth')).map({ [$_[0], $_[1], %eaw-long{$_[2]} // $_[2]] }));
emit-enum('HST',   parse-ranges(p('HangulSyllableType')));
emit-enum('DT',    parse-ranges(p('DerivedDecompositionType')));
emit-enum('NT',    parse-ranges(p('DerivedNumericType')));
emit-enum('JT',    parse-ranges(p('ArabicShaping'), :field(2)));
# MoarVM reports Joining_Group in the legacy ArabicShaping spelling: UPPERCASE,
# underscores as spaces (Syriac_Waw → "SYRIAC WAW").
emit-enum('JG', parse-ranges(p('DerivedJoiningGroup')).map({ [$_[0], $_[1], $_[2].uc.subst('_', ' ', :g)] }));

# The four normalization QUICK_CHECK properties share one file, keyed by the
# property name in field 1 with the value in field 2. Their values are reported
# by full name (Yes/No/Maybe), not the file's single letters; every codepoint
# the file does not mention is 'Yes'.
my %qc-long = Y => 'Yes', N => 'No', M => 'Maybe';
sub qc-rows($prop) {
    my @rows;
    for p('DerivedNormalizationProps').IO.lines -> $line {
        my $l = $line.split('#')[0].trim;
        next unless $l;
        my @f = $l.split(';').map(*.trim);
        next unless @f >= 3 && @f[1] eq $prop;
        my ($lo, $hi) = @f[0].contains('..') ?? @f[0].split('..') !! (@f[0], @f[0]);
        @rows.push([:16($lo), :16($hi), %qc-long{@f[2]} // @f[2]]);
    }
    @rows.sort({ $^a[0] <=> $^b[0] });
}
emit-enum('NFCQC',  qc-rows('NFC_QC'));
emit-enum('NFDQC',  qc-rows('NFD_QC'));
emit-enum('NFKCQC', qc-rows('NFKC_QC'));
emit-enum('NFKDQC', qc-rows('NFKD_QC'));

# Unicode_1_Name — field 10 of UnicodeData.txt, non-empty for ~2k codepoints
# (mostly controls, which have no Name at all and are known only by this one).
my @u1;
for p('UnicodeData').IO.lines -> $line {
    my @f = $line.split(';');
    next unless @f >= 11 && @f[10].trim;
    @u1.push([:16(@f[0]), @f[10].trim]);
}
@u1 = @u1.sort({ $^a[0] <=> $^b[0] });
@out.push: "extern const uint32_t U1NAME_CPS[] = \{";
my $u1row = '  ';
for @u1 -> $r { $u1row ~= "0x{$r[0].base(16)},"; if $u1row.chars > 110 { @out.push($u1row); $u1row = '  ' } }
@out.push($u1row) if $u1row.trim;
@out.push: "\};";
@out.push: "extern const char* const U1NAME_STRS[] = \{";
for @u1 -> $r { @out.push: '  "' ~ $r[1] ~ '",' }
@out.push: "\};";
@out.push: "extern const size_t U1NAME_N = {@u1.elems};";

emit-enum('INPC', parse-ranges(p('IndicPositionalCategory')));
emit-enum('INSC', parse-ranges(p('IndicSyllabicCategory')));

# Jamo_Short_Name: CODE ; NAME — the short Hangul jamo names ("GG"), one per
# codepoint, and empty for everything else. Kept as a (cp -> string) pair table.
my @jamo;
for p('Jamo').IO.lines -> $line {
    my $l = $line.split('#')[0].trim;
    next unless $l;
    my @f = $l.split(';').map(*.trim);
    next unless @f >= 2;
    @jamo.push([:16(@f[0]), @f[1]]);
}
@jamo = @jamo.sort({ $^a[0] <=> $^b[0] });
@out.push: "extern const uint32_t JAMOSN_CPS[] = \{";
my $jrow = '  ';
for @jamo -> $r { $jrow ~= "0x{$r[0].base(16)},"; if $jrow.chars > 110 { @out.push($jrow); $jrow = '  ' } }
@out.push($jrow) if $jrow.trim;
@out.push: "\};";
@out.push: "extern const char* const JAMOSN_STRS[] = \{";
for @jamo -> $r { @out.push: '  "' ~ $r[1] ~ '",' }
@out.push: "\};";
@out.push: "extern const size_t JAMOSN_N = {@jamo.elems};";

# Bidi_Paired_Bracket: CODE ; PAIRED ; TYPE — the paired codepoint and whether
# this one opens ('o') or closes ('c'). Everything else pairs with itself and
# is type 'n'.
my @brk;
for p('BidiBrackets').IO.lines -> $line {
    my $l = $line.split('#')[0].trim;
    next unless $l;
    my @f = $l.split(';').map(*.trim);
    next unless @f >= 3;
    @brk.push([:16(@f[0]), :16(@f[1]), @f[2]]);
}
@brk = @brk.sort({ $^a[0] <=> $^b[0] });
@out.push: "extern const uint32_t BIDIBRACKET[] = \{";
my $brow = '  ';
for @brk -> $r { $brow ~= "0x{$r[0].base(16)},0x{$r[1].base(16)},{$r[2] eq 'o' ?? 1 !! 2},"; if $brow.chars > 110 { @out.push($brow); $brow = '  ' } }
@out.push($brow) if $brow.trim;
@out.push: "\};";
@out.push: "extern const size_t BIDIBRACKET_N = {@brk.elems * 3};";

# PropertyValueAliases: every spelling of every value of the properties above,
# and of Script, Block, Bidi_Class and Canonical_Combining_Class, so that
# <:Prop<Value>> takes any of them (UAX #44 LM3 loose matching). A row is
# "prop;alias;alias…", the property normalized (lowercase, separators
# dropped) and the aliases as the file spells them. A row whose spellings all
# normalize alike is left out: comparing the value itself already answers it.
# General_Category is not here. It is never cut, so Unicode.cpp spells its
# aliases itself.
my %va-want = <age bc blk ccc dt ea gcb hst inpc insc jg jt lb nt
               nfcqc nfdqc nfkcqc nfkdqc sb sc wb>.Set;
sub va-norm($s) { $s.lc.comb.grep(/<[a..z0..9]>/).join }
my @va;
for p('PropertyValueAliases').IO.lines -> $line {
    my $l = $line.split('#')[0].trim;
    next unless $l;
    my @f = $l.split(';').map(*.trim);
    my $prop = va-norm(@f[0]);
    next unless %va-want{$prop};
    my @names = @f[1..*];
    next if @names.map(&va-norm).unique.elems == 1;
    @va.push: ($prop, |@names).join(';');
}
@out.push: "extern const char* const VALUE_ALIASES[] = \{";
@out.push: '  "' ~ $_ ~ '",' for @va;
@out.push: "\};";
@out.push: "extern const size_t VALUE_ALIASES_N = {@va.elems};";

# The SLIM seam (src/ucd_seam.h): the only way the runtime reaches the tables
# above, so this file and stub_ucd_props.cpp are interchangeable at link time.
@out.push: '';
@out.push: '// The SLIM seam (src/ucd_seam.h) — see unicode_names.cpp for the note.';
@out.push: 'const uint32_t* enumPropTable(const char* key, size_t* n, const char* const** vals) {';
for <AGE LB WB SB GCB EAW HST DT NT JT JG NFCQC NFDQC NFKCQC NFKDQC INPC INSC> -> $k {
    @out.push: "  if (!std::strcmp(key, \"$k\")) \{ *n = {$k}_RANGES_N; *vals = {$k}_VALUES; return {$k}_RANGES; \}";
}
@out.push: '  *n = 0; *vals = nullptr; return nullptr;';
@out.push: '}';
@out.push: 'const uint32_t* unicode1NameTable(size_t* n, const char* const** strs) { *n = U1NAME_N; *strs = U1NAME_STRS; return U1NAME_CPS; }';
@out.push: 'const uint32_t* jamoShortNameTable(size_t* n, const char* const** strs) { *n = JAMOSN_N; *strs = JAMOSN_STRS; return JAMOSN_CPS; }';
@out.push: 'const uint32_t* bidiBracketTable(size_t* n) { *n = BIDIBRACKET_N; return BIDIBRACKET; }';
@out.push: 'const char* const* valueAliasTable(size_t* n) { *n = VALUE_ALIASES_N; return VALUE_ALIASES; }';
@out.push: '}}';
spurt 'src/unicode_props2_gen.cpp', @out.join("\n") ~ "\n";
say "wrote src/unicode_props2_gen.cpp";

# Bidi_Mirroring_Glyph: CODE ; MIRROR  →  (cp, mirror) pairs sorted by cp.
@out = ();
@out.push: "// GENERATED by tools/gen_unicode_props2.raku (run by rakupp) from Unicode $VER — do not edit.";
@out.push: '#include <cstdint>';
@out.push: '#include <cstddef>';
@out.push: 'namespace rakupp { namespace ucd {';
my @mir;
for p('BidiMirroring').IO.lines -> $line {
    my $l = $line.split('#')[0].trim;
    next unless $l;
    my @f = $l.split(';').map(*.trim);
    next unless @f >= 2;
    @mir.push([:16(@f[0]), :16(@f[1])]);
}
@mir = @mir.sort({ $^a[0] <=> $^b[0] });
@out.push: "extern const uint32_t BIDIMIRROR[] = \{";
my $row = '  ';
for @mir -> $r { $row ~= "0x{$r[0].base(16)},0x{$r[1].base(16)},"; if $row.chars > 110 { @out.push($row); $row = '  ' } }
@out.push($row) if $row.trim;
@out.push: "\};";
@out.push: "extern const size_t BIDIMIRROR_N = {@mir.elems * 2};";

@out.push: '}}';
spurt 'src/unicode_mirror_gen.cpp', @out.join("\n") ~ "\n";
say "wrote src/unicode_mirror_gen.cpp";
