# twice each: the first evaluation decides a node's shape, the second runs it
my $bad = 0;
for ^2 {
    for @rows -> [$op, $a, $b, $want] {
        my $got = show($op, $a, $b);
        next if $got eq $want;
        $bad++;
        say "FAIL: $a $op $b — $got vs $want" if $bad <= 10;
    }
}
ck $bad, 0, "{+@rows} rows of Int operands";

# the same operators in loops, over variables and literals
my ($q, $m, $p, $g, $l, $lo, $hi, $dv);
for ^100 -> $i {
    $q = ($i - 50) div 7; $m = ($i - 50) mod -7; $dv = $i %% 7;
    $p = 3 ** ($i % 5); $g = $i gcd 12; $l = $i lcm 4; $lo = $i min 50; $hi = $i max 50;
}
ck ($q, $m, $dv, $p, $g, $l, $lo, $hi), (7, 0, False, 81, 3, 396, 50, 99), 'in a loop';
my $s = 0;
for 1..1000 -> $i { $s += $i div 3 + $i mod 3 + ($i %% 3 ?? 1 !! 0) + $i gcd 6 + ($i ** 2) div $i }
ck $s, 670831, 'a sum over all of them';
my ($ba, $bb) = -9223372036854775808, -1;
my @w; for ^3 { @w = $ba div $bb, $ba mod $bb, $ba %% $bb, $ba gcd 0, $ba ** 1, 2 ** 63 }
ck @w, [9223372036854775808, 0, True, 9223372036854775808, -9223372036854775808, 9223372036854775808],
   'the int64 edges in a loop';

# an allomorph and a native take the same answers
ck (<7> div 2, <-7> mod 3, <12> gcd 18, <5> min 3, <5> max 3), (3, 2, 6, 3, <5>), 'IntStr operands';
my int $ni = -7;
ck ($ni div 2, $ni mod 2, $ni %% 7, $ni ** 2, $ni gcd 21, $ni min 0, $ni max 0), (-4, 1, True, 49, 7, -7, 0), 'a native int';

say $fails ?? "FAIL ($fails)" !! 'PASS';
