# Regression: the Int word operators on applyArith's hot path.
#
# `div mod %% ** min max gcd lcm` over two machine Ints walked the general
# path's page of operator tests before their Int arms answered: `div` cost
# ~2,200 instructions where `+` cost 540 (O16 of the 2026-10 parallel review).
# They are now answered beside `+` and `%`, with the guards those arms keep:
# a zero divisor still fails or throws, `div` floors and `mod` takes the
# divisor's sign, -2**63 div -1 and -2**63 gcd 0 become big Ints, a power past
# int64 a big Int and a negative power a Rat.
#
# Every row was answered by Rakudo 2026.09. Three rows where Rakudo answers
# otherwise are left out: `0 lcm 0` (an X::AdHoc there), `0 ** -1` (<1/0>)
# and `(-1) ** -3` (<1/-1>). Runs clean under Rakudo.

my $fails = 0;
sub ck($got, $want, $desc) {
    if $got eqv $want { say "ok - $desc" }
    else { $fails++; say "FAIL: $desc — {$got.raku} vs {$want.raku}" }
}

sub apply($op, $a, $b) {
    given $op {
        when 'div' { $a div $b }; when 'mod' { $a mod $b }; when '%'   { $a % $b };
        when '%%'  { $a %% $b };  when '**'  { $a ** $b };  when 'gcd' { $a gcd $b };
        when 'lcm' { $a lcm $b }; when 'min' { $a min $b }; when 'max' { $a max $b };
    }
}
sub show($op, $a, $b) {
    my $v = try apply($op, $a, $b);
    return $!.^name without $v;
    $v ~~ Failure ?? $v.exception.^name !! $v.raku
}

