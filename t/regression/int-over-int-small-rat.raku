    ['/', Bool::True, 7, 'Rat 1 7'],
    ['/', Bool::True, 4611686018427387903, 'Rat 1 4611686018427387903'],
    ['/', Bool::True, -4611686018427387903, 'Rat -1 4611686018427387903'],
    ['/', Bool::True, 4611686018427387904, 'Rat 1 4611686018427387904'],
    ['/', Bool::True, 9223372036854775807, 'Rat 1 9223372036854775807'],
    ['/', Bool::True, -9223372036854775808, 'Rat -1 9223372036854775808'],
    ['/', Bool::True, <1/3>, 'Rat 3 1'],
    ['/', Bool::True, <-2/7>, 'Rat -7 2'],
    ['/', Bool::True, 1.25, 'Rat 4 5'],
    ['/', Bool::True, <3037000493/3037000453>, 'Rat 3037000453 3037000493'],
    ['/', Bool::True, <1/4611686018427387903>, 'Rat 4611686018427387903 1'],
    ['/', Bool::True, 2305843009213693951.5, 'Rat 2 4611686018427387903'],
    ['/', Bool::True, <1/9223372036854775807>, 'Rat 9223372036854775807 1'],
    ['/', Bool::True, Bool::True, 'Rat 1 1'],
;

# twice each: the first evaluation decides a node's shape, the second runs it
my $bad = 0;
for ^2 {
    for @rows -> [$op, $a, $b, $want] {
        my $got = show($op, $a, $b);
        next if $got eq $want;
        $bad++;
        say "FAIL: {$a.raku} $op {$b.raku} — $got vs $want" if $bad <= 10;
    }
}
ck $bad, 0, "{+@rows} rows of Int, Rat and Bool operands";

# literals over literals, in loops
my $r = 0; for ^30 { $r += 1/3 }
ck ($r, $r.WHAT), (10.0, Rat), '$r += 1/3';
my $t = 0; for ^30 { my $q = 1/3; $t += $q }
ck $t, 10.0, 'my $q = 1/3 in a loop';
my $h = 0; for 1..20 -> $i { $h += 1/$i }
ck $h.nude, (55835135, 15519504), 'the 20th harmonic number';
my @parts; for ^2 { @parts = (1/3).nude, (-1/3).nude, (1/-3).nude, (6/3).nude, (0/5).nude, (1/0).nude }
ck @parts, [(1, 3), (-1, 3), (-1, 3), (2, 1), (0, 1), (1, 0)], 'Int / Int literals';
ck (6/3).WHAT, Rat, '6/3 is still a Rat';
my $n = 1; for ^3 { $n = $n * 0.5 }
ck $n, 0.125, '$n * 0.5 from an Int';
my $big = 1/2**40; for ^1 { $big = $big * (1/2**40) }
ck ($big, $big.WHAT), (2e0 ** -80, Num), 'a denominator past 64 bits is a Num';

# FatRat stays FatRat; a lexical operator still wins
ck (FatRat.new(1, 3) + 1/3).WHAT, FatRat, 'FatRat + 1/3';
{
    sub infix:</>($a, $b) { 'slash' }
    ck 1/3, 'slash', 'a lexical infix:</> over two literals';
}

say $fails ?? "FAIL ($fails)" !! 'PASS';
