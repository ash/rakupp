# Regression: Int / Int and Rat arithmetic on the small-Rat lane.
#
# The exact tower's small-Rat lane (parts under 2**62, __int128 products, a
# binary gcd) was gated on a Rat operand, so `1/3` went through BigInt divmod
# and gcd, and every Rat `+ - * /` walked the general path's page of tests to
# reach the lane: `$r += 1/3` was ~7,800 instructions an iteration (O17 of the
# 2026-10 parallel review). The lane now takes Int / Int, applyArith calls it
# before the general path, and `1/3`, `$x * 0.5` and the like are typed
# subtrees, so `my $q = 1/3` stays on the declaration lane. What it answers
# is what the BigInt arms answer: a reduced Rat with a positive denominator,
# a zero denominator for `x / 0`, -2**63 / -1 as a big numerator, and a Num
# once a denominator is past 64 bits.
#
# Every row was answered by Rakudo 2026.09. Runs clean under Rakudo.

my $fails = 0;
sub ck($got, $want, $desc) {
    if $got eqv $want { say "ok - $desc" }
    else { $fails++; say "FAIL: $desc — {$got.raku} vs {$want.raku}" }
}

sub apply($op, $a, $b) {
    given $op { when '+' { $a + $b }; when '-' { $a - $b }; when '*' { $a * $b }; when '/' { $a / $b } }
}
sub show($op, $a, $b) {
    my $v = try apply($op, $a, $b);
    return $!.^name without $v;
    return $v.exception.^name if $v ~~ Failure;
    $v ~~ Rat ?? "Rat {$v.numerator} {$v.denominator}" !! "{$v.^name} {$v.raku}"
}

